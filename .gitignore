# Runtime evidence may contain private-vault titles, content, and local paths.
# Canonical implementation evidence remains in the private Digital Jochi vault.
site/evidence/

# Never copy the private vault or Obsidian state into this public repository.
/vault/
/site/vault/
/digital-jochi/
**/.obsidian/
**/99 Attachments/
*.db
*.db-*
*.sqlite
*.sqlite3

